# Database Configuration
DATABASE_URL=postgresql://barodago_user:barodago_pass_2026@localhost:5432/barodago
POSTGRES_DB=barodago
POSTGRES_USER=barodago_user
POSTGRES_PASSWORD=barodago_pass_2026

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://barodago:barodago_rabbit_2026@localhost:5672/
CELERY_BROKER_URL=amqp://barodago:barodago_rabbit_2026@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# Google Gemini API (for Vision AI)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Authentication (Firebase/Clerk)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Mapbox (for Admin Panel)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# File Storage (AWS S3 or Google Cloud Storage)
STORAGE_BUCKET=barodago-uploads
GCP_PROJECT_ID=your_gcp_project_id
GCP_CREDENTIALS_PATH=/path/to/credentials.json

# Application Settings
APP_ENV=development
SECRET_KEY=your_secret_key_for_jwt_signing_change_in_production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Image Processing
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# AI Settings
CLIP_MODEL=openai/clip-vit-base-patch32
SIMILARITY_THRESHOLD=0.85
DUPLICATE_DETECTION_RADIUS_METERS=50

# Gamification
BANYAN_POINTS_PER_REPORT=10
BANYAN_POINTS_PER_HIGHFIVE=1
BANYAN_POINTS_PER_VERIFICATION=50

# Crowdfunding
SANSKARI_SANCHAY_VOTE_THRESHOLD=100
MIN_CONTRIBUTION_INR=10
MAX_CONTRIBUTION_INR=10000
